{
  "manifest_version": "0.1.0",
  "workspace_id": "flossi0ullk",
  "workspace_name": "FLOSSI0ULLK",
  "rules": [
    "Keep hook policy canonical in-repo and project it outward.",
    "Preserve unrelated agent-native settings; only managed hook events are rewritten.",
    "Use one shared checkpoint + post-write consensus path before inventing per-client variants.",
    "Prefer non-blocking observability and cheap background consensus over prompt-time token burn."
  ],
  "hook_scripts": [
    "FLOSS/hooks/hook_pre_write.py",
    "FLOSS/hooks/hook_post_write.py",
    "FLOSS/hooks/hook_bg_round.py"
  ],
  "targets": {
    "claude": {
      "enabled": true,
      "settings_path": ".claude/settings.json",
      "hooks": {
        "PreToolUse": [
          {
            "matcher": "Write|Edit|MultiEdit",
            "hooks": [
              {
                "type": "command",
                "command": "C:/Python313/python.exe C:/~shit/FLOSS/hooks/hook_pre_write.py"
              }
            ]
          }
        ],
        "PostToolUse": [
          {
            "matcher": "Write|Edit|MultiEdit",
            "hooks": [
              {
                "type": "command",
                "command": "C:/Python313/python.exe C:/~shit/FLOSS/hooks/hook_post_write.py"
              }
            ]
          }
        ]
      }
    },
    "gemini": {
      "enabled": true,
      "settings_path": ".gemini/settings.json",
      "hooksConfig": {
        "enabled": true,
        "notifications": true,
        "disabled": []
      },
      "hooks": {
        "BeforeTool": [
          {
            "matcher": "write_file|replace",
            "sequential": true,
            "hooks": [
              {
                "name": "flossi0ullk-pre-write",
                "type": "command",
                "command": "C:/Python313/python.exe C:/~shit/FLOSS/hooks/hook_pre_write.py --stdout-json",
                "timeout": 60000,
                "description": "Checkpoint substantive code edits before the tool mutates the file."
              }
            ]
          }
        ],
        "AfterTool": [
          {
            "matcher": "write_file|replace",
            "sequential": true,
            "hooks": [
              {
                "name": "flossi0ullk-post-write",
                "type": "command",
                "command": "C:/Python313/python.exe C:/~shit/FLOSS/hooks/hook_post_write.py --stdout-json",
                "timeout": 60000,
                "description": "Submit substantive code edits into the FLOSSI0ULLK local consensus gateway."
              }
            ]
          }
        ]
      }
    },
    "codex": {
      "enabled": true,
      "settings_path": ".codex/hooks.json",
      "payload_shape": "hooks_only",
      "hooks": {
        "PreToolUse": [
          {
            "matcher": "Write|Edit|MultiEdit",
            "hooks": [
              {
                "type": "command",
                "command": "C:/Python313/python.exe C:/~shit/FLOSS/hooks/hook_pre_write.py"
              }
            ]
          }
        ],
        "PostToolUse": [
          {
            "matcher": "Write|Edit|MultiEdit",
            "hooks": [
              {
                "type": "command",
                "command": "C:/Python313/python.exe C:/~shit/FLOSS/hooks/hook_post_write.py"
              }
            ]
          }
        ],
        "SessionStart": [
          {
            "matcher": "*",
            "hooks": [
              {
                "type": "command",
                "command": "C:/Python313/python.exe C:/~shit/FLOSS/hooks/session_start_inject.py"
              }
            ]
          }
        ]
      }
    },
    "hermes_workspace": {
      "enabled": true,
      "scope": "repo",
      "settings_path": ".toilet/hermes/config.yaml",
      "format": "yaml",
      "entry_shape": "flat",
      "event_map": {
        "PreToolUse": "pre_tool_call",
        "PostToolUse": "post_tool_call"
      },
      "reason": "SessionStart is intentionally omitted -- it has no clean Hermes equivalent, so it is left unmapped rather than inventing one; the event_map mechanism drops any manifest event absent from it. This is the same config.yaml the hermes_workspace MCP target writes (workspace-scoped, repo .toilet/), never the AppData hermes_user home -- that gateway is live and out of scope for this target. `entry_shape: \"flat\"` is required because Hermes's own `agent/shell_hooks.py::_parse_single_entry` expects one flat `{matcher?, command}` mapping per hook, not the Claude-Code-nested `{matcher, hooks: [{type, command}]}` shape the other targets use -- the nested shape parsed to zero hooks (warn-and-skip on the missing `command` field) until this was fixed. The matcher is `write_file|patch` (Hermes's actual file-editing tool names -- confirmed against `tools/file_tools.py`), not `Write|Edit|MultiEdit`, which is Claude/Codex vocabulary Hermes tools never emit; `ShellHookSpec.matches_tool` fullmatches this as a regex against `tool_name`.",
      "hooks": {
        "PreToolUse": [
          {
            "matcher": "write_file|patch",
            "hooks": [
              {
                "type": "command",
                "command": "C:/Python313/python.exe C:/~shit/FLOSS/hooks/hook_pre_write.py"
              }
            ]
          }
        ],
        "PostToolUse": [
          {
            "matcher": "write_file|patch",
            "hooks": [
              {
                "type": "command",
                "command": "C:/Python313/python.exe C:/~shit/FLOSS/hooks/hook_post_write.py"
              }
            ]
          }
        ]
      }
    },
    "opencode": {
      "enabled": false,
      "status": "pending",
      "reason": "No stable first-class hook configuration surface has been identified for OpenCode here yet."
    }
  }
}
