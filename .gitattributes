# FLOSSI0ULLK / FLOSS line-ending normalization
# Root-cause fix for cross-tool CRLF<->LF churn (Codex / Antigravity / editors on Windows).
# Without this, re-saving any file makes git see the whole file changed, burying real diffs.

# Default: normalize text to LF in repo and working tree.
* text=auto eol=lf

# Windows-native scripts keep CRLF.
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Source code: explicit text (LF).
*.rs    text eol=lf
*.py    text eol=lf
*.toml  text eol=lf
*.json  text eol=lf
*.md    text eol=lf

# Binary — never apply line-ending transforms.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.tar   binary
*.wasm  binary
*.dna   binary
*.happ  binary
*.key   binary

# Cryptographic identity / source-chain material — binary regardless of name.
**/identity/** binary
*.chain.json binary

# Review and provenance EVIDENCE — byte-preserved, never transformed.
# `*.json text eol=lf` above rewrote a committed review synthesis from 200,104
# CRLF bytes to 193,821 LF bytes, so the sha256 published alongside it as its
# integrity claim did not match what a clone would receive. An evidence record
# whose hash only verifies on the machine that wrote it is not evidence.
docs/reviews/**/*.json -text
.agent-surface/provenance/**/*.json -text
docs/reviews/**/*.txt -text
