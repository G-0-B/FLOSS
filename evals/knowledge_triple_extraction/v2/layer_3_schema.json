{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Layer3AcceptanceItem",
  "type": "object",
  "required": [
    "document_id",
    "domain",
    "title",
    "rights_receipt",
    "source_hash",
    "parser_route",
    "passages",
    "dual_annotation",
    "adjudication"
  ],
  "properties": {
    "document_id": {
      "type": "string"
    },
    "domain": {
      "type": "string",
      "enum": ["biomedical", "computer_science", "governance_commons"]
    },
    "title": {
      "type": "string"
    },
    "rights_receipt": {
      "type": "object",
      "required": ["license", "sensitive_data_classification", "local_processing_permitted"],
      "properties": {
        "license": {"type": "string"},
        "sensitive_data_classification": {"type": "string"},
        "local_processing_permitted": {"type": "boolean"},
        "source_url": {"type": ["string", "null"]}
      }
    },
    "source_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "parser_route": {
      "type": "string"
    },
    "passages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["passage_id", "passage_type", "text", "eligible_claims"],
        "properties": {
          "passage_id": {"type": "string"},
          "passage_type": {
            "type": "string",
            "enum": ["informative", "null_passage", "table", "figure_caption"]
          },
          "text": {"type": "string"},
          "eligible_claims": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "claim_id",
                "statement",
                "subject_surface",
                "relation_surface",
                "object_surface",
                "polarity",
                "modality_strength",
                "evidence_atoms"
              ],
              "properties": {
                "claim_id": {"type": "string"},
                "statement": {"type": "string"},
                "subject_surface": {"type": "string"},
                "relation_surface": {"type": "string"},
                "object_surface": {"type": "string"},
                "polarity": {
                  "type": "string",
                  "enum": ["affirmed", "negated", "denied_evidence"]
                },
                "modality_strength": {
                  "type": "string",
                  "enum": ["asserted", "probable", "possible", "hypothetical"]
                },
                "attribution_kind": {"type": "string"},
                "hazard_tags": {
                  "type": "array",
                  "items": {"type": "string"}
                },
                "evidence_atoms": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["atom_id", "atom_type", "grounding_class", "literal_content"],
                    "properties": {
                      "atom_id": {"type": "string"},
                      "atom_type": {"type": "string"},
                      "grounding_class": {"type": "string"},
                      "literal_content": {"type": "string"},
                      "char_range": {
                        "type": ["array", "null"],
                        "items": {"type": "integer"}
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "dual_annotation": {
      "type": "object",
      "required": ["annotator_a", "annotator_b", "agreement_score", "disagreements"],
      "properties": {
        "annotator_a": {"type": "string"},
        "annotator_b": {"type": "string"},
        "agreement_score": {"type": "number"},
        "disagreements": {"type": "array"}
      }
    },
    "adjudication": {
      "type": "object",
      "required": ["adjudication_id", "adjudicator", "status"],
      "properties": {
        "adjudication_id": {"type": "string"},
        "adjudicator": {"type": "string"},
        "status": {
          "type": "string",
          "enum": ["APPROVED_GOLD", "PROVISIONAL", "EXCLUDED"]
        },
        "adjudication_notes": {"type": "string"}
      }
    }
  }
}
