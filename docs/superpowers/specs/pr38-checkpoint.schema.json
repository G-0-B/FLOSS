{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flossi0ullk.local/superpowers/pr38-checkpoint.schema.json",
  "title": "PR 38 Salvage Continuation Checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sequence",
    "previous_digest",
    "digest",
    "state_id",
    "phase",
    "input_shas",
    "capsule_root",
    "manifest_digest",
    "completed_actions",
    "blockers",
    "human_decisions",
    "next_safe_command",
    "recovery_command"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "sequence": {"type": "integer", "minimum": 0},
    "previous_digest": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "digest": {"$ref": "#/$defs/digest"},
    "state_id": {"type": "string", "minLength": 1},
    "phase": {"type": "string", "minLength": 1},
    "input_shas": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}
    },
    "capsule_root": {"$ref": "#/$defs/digest"},
    "manifest_digest": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "completed_actions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "blockers": {
      "type": "array",
      "items": {"type": "string"}
    },
    "human_decisions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "next_safe_command": {"type": "string", "minLength": 1},
    "recovery_command": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"sequence": {"const": 0}}, "required": ["sequence"]},
      "then": {"properties": {"previous_digest": {"type": "null"}}}
    },
    {
      "if": {"properties": {"sequence": {"minimum": 1}}, "required": ["sequence"]},
      "then": {
        "properties": {
          "previous_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
