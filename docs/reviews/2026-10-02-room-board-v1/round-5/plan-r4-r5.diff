+function Get-LogRow {
+    # The one row of the shared log with this seq. Throws if it is missing or
+    # if the seq appears more than once.
+    param([int]$Seq)
+    $rows = @(Get-Content $log -Encoding UTF8 |
+        Where-Object { $_.Trim() } |
+        ForEach-Object { ConvertFrom-Json $_ } |
+        Where-Object { $_.seq -eq $Seq })
