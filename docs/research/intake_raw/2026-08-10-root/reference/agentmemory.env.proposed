# =============================================================================
# agentmemory — FLOSSI0ULLK "best plausible" config
# Copy to:  C:\Users\kalis\.agentmemory\.env   →  then:  agentmemory doctor
# Truth-status: ⚠️ Specified — verify with `agentmemory doctor` after copying.
# =============================================================================
# The flourishing dial this file encodes:
#   SOVEREIGN    — embeddings + recall run locally; no memory data leaves the box.
#   SHARED       — ONE team memory; every agent (Cowork, Codex, Antigravity) starts oriented.
#   PLANES-CLEAN — agentmemory is Plane A (advisory); it NEVER auto-writes canon.
#   LEAN         — cheap compression, lean injection budget; honors token discipline.
#   LIVING       — memory consolidates + decays (Ebbinghaus); reinforced memory persists.
#   RESILIENT    — periodic snapshots + provider fallback.

# --- 1. LLM provider (compression / summarise / consolidate) -----------------
# Do NOT reintroduce the dead Omi OpenAI key — OPENAI_API_KEY is first in the
# detection order, which is exactly what broke embeddings. Use a cheap, in-roster
# model: Gemini 2.5 Flash. (Premium keys are wasted on background compression.)
GEMINI_API_KEY=__PUT_YOUR_GEMINI_KEY__
GEMINI_MODEL=gemini-2.5-flash
MAX_TOKENS=4096
FALLBACK_PROVIDERS=openrouter          # resilience if Gemini rate-limits (needs OPENROUTER_API_KEY)
# OPENROUTER_API_KEY=sk-or-...          # uncomment + add your key to arm the fallback
#
# SOVEREIGN-MAX alternative: comment out GEMINI_API_KEY → "noop" mode. Synthetic
# compression + BM25 + local vectors still work; you only lose LLM summaries.
# (Today OPENAI_BASE_URL routes embeddings only, not chat — so Groq/Cerebras
#  compression isn't wired upstream yet; tracked as agentmemory PR #307.)

# --- 2. Embeddings — LOCAL: the sovereignty AND the bug-fix ------------------
EMBEDDING_PROVIDER=local               # Xenova/all-MiniLM-L6-v2, 384-dim, offline, free.
                                       # REQUIRED even with a Gemini key present, else it would
                                       # silently use PAID Gemini embeddings and send data out.
AGENTMEMORY_DROP_STALE_INDEX=true      # one-time: drops the stale 1536-dim (OpenAI) index so the
                                       # 384-dim local index rebuilds cleanly after the switch.

# --- 3. Auth (loopback-only today) ------------------------------------------
# Leave unset while bound to localhost. The MOMENT you expose it (mesh/remote), set:
# AGENTMEMORY_SECRET=__generate_a_long_random_secret__

# --- 4. Search tuning -------------------------------------------------------
BM25_WEIGHT=0.5                        # local 384-dim vectors are weaker than API embeddings,
VECTOR_WEIGHT=0.5                      # so balance the legs evenly (vs the 0.4/0.6 default).
AGENTMEMORY_GRAPH_WEIGHT=0.2
TOKEN_BUDGET=2000                      # lean by intent — honors the project's token discipline.
MAX_OBS_PER_SESSION=500

# --- 5. Behaviour — living memory, planes stay clean ------------------------
AGENTMEMORY_INJECT_CONTEXT=true        # every agent starts oriented — the whole point.
AGENTMEMORY_AUTO_COMPRESS=true         # richer memories; cheap on Gemini Flash.
CONSOLIDATION_ENABLED=true             # 4-tier: working → episodic → semantic → procedural.
CONSOLIDATION_DECAY_DAYS=60            # long-arc project: reinforced memory persists, stale fades (default 30).
GRAPH_EXTRACTION_ENABLED=true          # concept graph → better recall; aligns with KnowledgeTriple direction.
AGENTMEMORY_REFLECT=false              # OFF for now. Auto-synthesis is the exact pattern that bit us this
                                       # week. Flip to true only once the Plane-A → canon gate is trusted.

# --- 6. Multi-agent coordination (the git-stomping fix) ---------------------
AGENTMEMORY_TOOLS=all                  # leases + signals: how agents stop touching the same surface.
TEAM_MODE=shared                       # ONE shared memory across all agents.
TEAM_ID=flossi0ullk
USER_ID=anthony                        # keep identical across ALL agents so memory is truly shared.
AGENTMEMORY_URL=http://localhost:3111
# AGENTMEMORY_FORCE_PROXY=1            # set ONLY for a client that can't probe localhost (sandboxed MCP).

# --- 7. Resilience ----------------------------------------------------------
SNAPSHOT_ENABLED=true
SNAPSHOT_INTERVAL=3600                 # hourly snapshots of memory state.
SNAPSHOT_DIR=~/.agentmemory/snapshots
AGENTMEMORY_EXPORT_ROOT=~/agentmemory-backup

# --- 8. Planes discipline — DO NOT auto-write canon -------------------------
# Intentionally LEFT UNSET: CLAUDE_MEMORY_BRIDGE, OBSIDIAN_AUTO_EXPORT.
# CLAUDE.md is curated canon; Plane-A memory mirroring into it = doc-explosion +
# the autonomous-write hazard. Keep the planes separate (the lens already enforces
# "canon wins on conflict").
